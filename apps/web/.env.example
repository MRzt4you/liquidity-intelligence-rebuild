# Leave blank when the web Worker serves its own /api/live routes.
NEXT_PUBLIC_API_URL=

# HTTP RPC for snapshots/history/health.
SOLANA_RPC_URL=https://YOUR-DEDICATED-SOLANA-RPC.example.com

# Standard Solana PubSub WebSocket RPC. Comma-separated URLs are supported for failover.
SOLANA_WS_URLS=wss://YOUR-DEDICATED-SOLANA-WS.example.com

# Optional: Solami decoded market-data WebSocket.
# If enabled, the server can consume decoded token/swap/liquidity/pool events.
# Keep the API key server-side; never use NEXT_PUBLIC_ prefix.
SOLAMI_DATA_WS_URL=wss://ws.solami.dev/data/subscribe?chain=solana
SOLAMI_API_KEY=

# Optional enrichment / security providers. Keys stay server-side; never use NEXT_PUBLIC_ prefix.
JUPITER_API_KEY=
BIRDEYE_API_KEY=
GOPLUS_API_KEY=
HELIUS_API_KEY=
