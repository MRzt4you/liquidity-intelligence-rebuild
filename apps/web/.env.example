# Leave blank when the web Worker serves its own /api/live routes.
NEXT_PUBLIC_API_URL=

# REQUIRED FOR STABLE PRODUCTION REALTIME: dedicated Solana WebSocket RPC.
# Comma-separated URLs are supported for failover.
SOLANA_WS_URLS=wss://YOUR-DEDICATED-SOLANA-WS.example.com
SOLANA_RPC_URL=https://YOUR-DEDICATED-SOLANA-RPC.example.com

# Optional enrichment / security providers. Keys stay server-side; never use NEXT_PUBLIC_ prefix.
JUPITER_API_KEY=
BIRDEYE_API_KEY=
GOPLUS_API_KEY=
HELIUS_API_KEY=
