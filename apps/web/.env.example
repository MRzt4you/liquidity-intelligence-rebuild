# Leave blank when the web Worker serves its own /api/live routes.
NEXT_PUBLIC_API_URL=

# Optional dedicated HTTP RPC. Multiple comma-separated URLs are supported.
SOLANA_RPC_URL=

# Optional custom Solana PubSub WSS URLs, comma-separated.
SOLANA_WS_URLS=

# Free-tier provider keys (server-side only).
# Helius: used for HTTPS RPC + WebSocket when configured.
HELIUS_API_KEY=
# Alchemy: used for HTTPS RPC + WebSocket when configured.
ALCHEMY_API_KEY=

# Optional: Solami decoded market-data WebSocket.
SOLAMI_DATA_WS_URL=wss://ws.solami.dev/data/subscribe?chain=solana
SOLAMI_API_KEY=

# Optional enrichment / security providers. Keys stay server-side; never use NEXT_PUBLIC_ prefix.
JUPITER_API_KEY=
BIRDEYE_API_KEY=
GOPLUS_API_KEY=
