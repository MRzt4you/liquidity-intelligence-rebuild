# Local API defaults only. Public Solana RPCs are rate-limited and are not production-grade.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Prefer dedicated RPC/WS for production and set these on the deployed Worker.
# SOLANA_RPC_URL=https://YOUR-DEDICATED-SOLANA-RPC.example.com
# SOLANA_WS_URLS=wss://YOUR-DEDICATED-SOLANA-WS.example.com

BNB_RPC_URL=https://bsc-dataseed.binance.org
BNB_WS_URL=wss://bsc-ws-node.nariox.org:443
DATABASE_URL=postgresql://postgres:postgres@db:5432/liquidity
REDIS_URL=redis://redis:6379
API_PORT=4000

# Empty means the Cloudflare web app uses its own same-origin /api/live routes.
NEXT_PUBLIC_API_URL=
