# Realtime Solana / Pump.fun
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
# Optional comma-separated dedicated endpoints:
# SOLANA_RPC_URL=https://YOUR-RPC.example.com
# SOLANA_WS_URLS=wss://YOUR-WS.example.com

# Optional provider credentials (server-side only)
HELIUS_API_KEY=
ALCHEMY_API_KEY=
SOLAMI_DATA_WS_URL=wss://ws.solami.dev/data/subscribe?chain=solana
SOLAMI_API_KEY=

# Market / enrichment providers (server-side only)
JUPITER_API_KEY=
BIRDEYE_API_KEY=
GOPLUS_API_KEY=

# DexScreener is public but rate limited; never expose a private key client-side.
DEXSCREENER_API_URL=https://api.dexscreener.com

# Bitquery V2 wallet / historical intelligence (server-side only)
BITQUERY_TOKEN=
BITQUERY_GRAPHQL_URL=https://streaming.bitquery.io/graphql

# Legacy API / local services
BNB_RPC_URL=https://bsc-dataseed.binance.org
BNB_WS_URL=wss://bsc-ws-node.nariox.org:443
DATABASE_URL=postgresql://postgres:postgres@db:5432/liquidity
REDIS_URL=redis://redis:6379
API_PORT=4000

# Empty means the Cloudflare web app uses its own same-origin /api/live routes.
NEXT_PUBLIC_API_URL=
